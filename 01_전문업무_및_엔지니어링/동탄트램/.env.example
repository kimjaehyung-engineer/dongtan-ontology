# Required for scripts in 02_클라우드_원격 and cloud exports/backups.
DONGTAN_CLOUD_URI=
DONGTAN_CLOUD_USER=
DONGTAN_CLOUD_PASSWORD=

# Optional local Memgraph overrides. Defaults to bolt://localhost:7687 without auth.
DONGTAN_LOCAL_URI=
DONGTAN_LOCAL_USER=
DONGTAN_LOCAL_PASSWORD=

# Optional path overrides. Relative paths are resolved from this project directory.
DONGTAN_NODES_CSV=
DONGTAN_RELATIONSHIPS_CSV=
DONGTAN_ONTOLOGY_OUTPUT=
